# ==============================================================================
# SISMOWATCH ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

# --- BASE DE DATOS POSTGRESQL ---
POSTGRES_USER=sismo_admin
POSTGRES_PASSWORD=change_this_secure_password_in_env
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
AIRFLOW_DB=airflow_db
APP_DB=sismowatch_db

# --- APACHE AIRFLOW ---
AIRFLOW_ADMIN_USER=airflow_admin
AIRFLOW_ADMIN_PASSWORD=change_this_admin_password
AIRFLOW_ADMIN_EMAIL=admin@sismowatch.internal
AIRFLOW_FERNET_KEY=generate_fernet_key_base64_32bytes=
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false
AIRFLOW__CORE__LOAD_EXAMPLES=false

# --- MINIO LAKEHOUSE (S3) ---
MINIO_ROOT_USER=minio_sismo_master
MINIO_ROOT_PASSWORD=change_this_minio_password
MINIO_ENDPOINT=minio:9000
MINIO_CONSOLE_PORT=9001
MINIO_API_PORT=9000

# --- SEGURIDAD JWT Y ROLES ---
JWT_SECRET=change_this_hex_jwt_secret_token
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- SEED USERS DE APLICACION ---
SEED_ADMIN_EMAIL=admin@sismowatch.internal
SEED_ADMIN_PASSWORD=Admin2026!Secure
SEED_VIEWER_EMAIL=viewer@sismowatch.internal
SEED_VIEWER_PASSWORD=Viewer2026!Secure

# --- OLLAMA LOCAL ENGINE ---
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b

# --- FRONTEND Y API ---
VITE_API_URL=http://localhost:8000
PORT_API=8000
PORT_WEB=3000
PORT_OPENMETADATA=8585
PORT_SPARK_MASTER=7077
PORT_SPARK_UI=8081
